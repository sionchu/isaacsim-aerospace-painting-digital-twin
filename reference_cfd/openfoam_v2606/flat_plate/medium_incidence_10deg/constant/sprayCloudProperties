    {
        schemes
        {
            rho explicit 1;
            U explicit 1;
            Yi explicit 1;
            h explicit 1;
            radiation explicit 1;
        }
    }
    interpolationSchemes
    {
        rho cell;
        U cellPoint;
        thermo:mu cell;
        T cell;
        Cp cell;
        kappa cell;
        p cell;
    }
    integrationSchemes
    {
        U Euler;
        T analytical;
    }
}

